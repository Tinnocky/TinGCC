, -> COMMA_TOKEN, LEN: 1, LINE: 2 
3 -> INTEGER_LITERAL_TOKEN, LEN: 1, LINE: 3 
) -> CLOSE_PAREN_TOKEN, LEN: 1, LINE: 3 
\n -> END_OF_LINE_TOKEN, LEN: 1, LINE: 4 
[ -> OPEN_BRACKET_TOKEN, LEN: 1, LINE: 4 
1 -> INTEGER_LITERAL_TOKEN, LEN: 1, LINE: 4 
, -> COMMA_TOKEN, LEN: 1, LINE: 4 
2 -> INTEGER_LITERAL_TOKEN, LEN: 1, LINE: 5 
, -> COMMA_TOKEN, LEN: 1, LINE: 5 
3 -> INTEGER_LITERAL_TOKEN, LEN: 1, LINE: 6 
] -> CLOSE_BRACKET_TOKEN, LEN: 1, LINE: 6 
