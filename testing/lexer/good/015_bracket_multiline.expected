foo -> IDENTIFIER_TOKEN, LEN: 3, LINE: 1 
( -> OPEN_PAREN_TOKEN, LEN: 1, LINE: 1 
1 -> INTEGER_LITERAL_TOKEN, LEN: 1, LINE: 1 
, -> COMMA_TOKEN, LEN: 1, LINE: 1 
